@inproceedings{10.1145/3715668.3736344,
author = {Nogueira, Beatriz and Sim\~{a}o, Hugo and Bernardino, Alexandre and Forlizzi, Jodi and Guerreiro, Tiago},
title = {Putting the Age in Agency: A Case Study of an Older Adult Controlling a Telepresence Robot in a Family Setting},
year = {2025},
isbn = {9798400714863},
publisher = {Association for Computing Machinery},
address = {New York, NY, USA},
url = {https://doi.org/10.1145/3715668.3736344},
doi = {10.1145/3715668.3736344},
abstract = {As telepresence robots become increasingly integrated into domestic settings, their development for older adults’ agency and control is critical. Typically, telepresence robots are operated remotely by family members or caregivers, leaving older adults passively reliant on others to initiate contact. We explore the implications of shifting agency by empowering older adults to control the robot, thereby increasing their autonomy and control over the social dynamic. Through an auto-ethnographic study with one family divided into two households (1 + 4 people) over seven days, we explored the older adult’s control of the robot, the increased agency and its impact on participants and family dynamics. Our preliminary findings contribute insights into a novel design space where older adults control teleoperated robots deployed in another household. We elaborate on considerations and implications for the older adults operating the robots and the family members interacting with the robots under this new paradigm.},
booktitle = {Companion Publication of the 2025 ACM Designing Interactive Systems Conference},
pages = {508–512},
numpages = {5},
keywords = {Agency, Older Adults, Telepresence Robots, Family, Domestic Settings},
location = {
},
series = {DIS '25 Companion}
}

